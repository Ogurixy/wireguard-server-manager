<Window x:Class="WireGuardServerManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WireGuardServerManager.App"
        mc:Ignorable="d"
        Title="WireGuard Server Manager" Height="760" Width="1280" MinHeight="600" MinWidth="980" Background="#F4F6F8" Loaded="MainWindow_Loaded">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#0F172A"><DockPanel Margin="18,22">
            <StackPanel DockPanel.Dock="Top"><TextBlock Text="WG MANAGER" Foreground="#93C5FD" FontSize="13" FontWeight="Bold"/><TextBlock Text="WireGuard Server Manager" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,25" TextWrapping="Wrap"/></StackPanel>
            <StackPanel>
                <StackPanel.Resources><Style TargetType="Button"><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="14,7"/><Setter Property="FontSize" Value="14"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Margin" Value="0,1"/></Style></StackPanel.Resources>
                <Button x:Name="DashboardNavButton" Content="▦   Dashboard" Click="Dashboard_Click" Background="Transparent" Foreground="#CBD5E1"/>
                <Button x:Name="ServersNavButton" Content="▣   Servers" Click="Servers_Click" Background="Transparent" Foreground="#CBD5E1"/>
                <Button x:Name="UsersNavButton" Content="♙   Users" Click="Users_Click" Background="Transparent" Foreground="#CBD5E1"/>
                <Button x:Name="DevicesNavButton" Content="◉   Devices" Click="Devices_Click" Background="Transparent" Foreground="#CBD5E1"/>
                <Button x:Name="OnlineDevicesNavButton" Content="↔   Online Devices" Click="OnlineDevices_Click" Background="Transparent" Foreground="#CBD5E1"/>
                <Button x:Name="PeersNavButton" Content="◈   WireGuard Peers" Click="Peers_Click" Background="Transparent" Foreground="#CBD5E1"/>
                <Button x:Name="HistoryNavButton" Content="◷   Connection History" Click="History_Click" Background="Transparent" Foreground="#CBD5E1"/>
                <Button x:Name="TrafficNavButton" Content="▤   Traffic" Click="Traffic_Click" Background="Transparent" Foreground="#CBD5E1"/>
                <Button x:Name="UnknownPeersNavButton" Content="⚠   Unknown Peers" Click="UnknownPeers_Click" Background="Transparent" Foreground="#CBD5E1"/>
                <Button x:Name="SecurityEventsNavButton" Content="⚠   Security Events" Click="SecurityEvents_Click" Background="Transparent" Foreground="#CBD5E1"/>
                <Button x:Name="BlacklistNavButton" Content="⊘   Blacklist" Click="Blacklist_Click" Background="Transparent" Foreground="#CBD5E1"/>
                <Button x:Name="WhitelistNavButton" Content="⊙   Whitelist" Click="Whitelist_Click" Background="Transparent" Foreground="#CBD5E1"/>
                <Button x:Name="SettingsNavButton" Content="⚙   Settings" Click="Settings_Click" Background="Transparent" Foreground="#CBD5E1"/>
                <Button x:Name="AuditLogsNavButton" Content="▥   Audit Logs" Click="AuditLogs_Click" Background="Transparent" Foreground="#CBD5E1"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="第一阶段 · WireGuard only" Foreground="#64748B" FontSize="11" Margin="0,20,0,0"/>
        </DockPanel></Border>
        <Grid Grid.Column="1" Margin="32">
            <Grid x:Name="DashboardView"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,24"><StackPanel DockPanel.Dock="Left"><TextBlock Text="Dashboard" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" Text="WireGuard 服务器运行概览" Foreground="#64748B" Margin="0,4,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="SSH 用户" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="SshUserTextBox" Text="root" Width="110" Padding="8,6" Margin="0,0,10,0"/><Button Content="SSH 同步选中" Click="Refresh_Click" Background="#2563EB" Foreground="White"/><Button Content="同步全部" Click="SyncAll_Click" Margin="8,0,0,0"/></StackPanel></DockPanel>
                <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,24"><Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,12,0"><StackPanel><TextBlock Text="Servers" Foreground="#64748B"/><TextBlock x:Name="ServerCountText" Text="2" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="已配置服务器" Foreground="#64748B" FontSize="12"/></StackPanel></Border><Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,12,0"><StackPanel><TextBlock Text="Healthy Servers" Foreground="#64748B"/><TextBlock x:Name="HealthyCountText" Text="—" FontSize="28" FontWeight="Bold" Foreground="#16A34A" Margin="0,8,0,0"/><TextBlock Text="等待 SSH 同步" Foreground="#64748B" FontSize="12"/></StackPanel></Border><Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,12,0"><StackPanel><TextBlock Text="Online Devices" Foreground="#64748B"/><TextBlock x:Name="OnlineCountText" Text="0" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="最近握手在线" Foreground="#64748B" FontSize="12"/></StackPanel></Border><Border Background="White" CornerRadius="10" Padding="18"><StackPanel><TextBlock Text="Unknown Peers" Foreground="#64748B"/><TextBlock x:Name="UnknownCountText" Text="0" FontSize="28" FontWeight="Bold" Foreground="#D97706" Margin="0,8,0,0"/><TextBlock Text="安全事件待处理" Foreground="#64748B" FontSize="12"/></StackPanel></Border><Border Background="White" CornerRadius="10" Padding="18" Margin="0,12,12,0"><StackPanel><TextBlock Text="Users" Foreground="#64748B"/><TextBlock x:Name="UserCountText" Text="0" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="启用用户" Foreground="#64748B" FontSize="12"/></StackPanel></Border><Border Background="White" CornerRadius="10" Padding="18" Margin="0,12,12,0"><StackPanel><TextBlock Text="Devices" Foreground="#64748B"/><TextBlock x:Name="DeviceCountText" Text="0" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="未软删除设备" Foreground="#64748B" FontSize="12"/></StackPanel></Border><Border Background="White" CornerRadius="10" Padding="18" Margin="0,12,12,0"><StackPanel><TextBlock Text="Today Traffic" Foreground="#64748B"/><TextBlock x:Name="TodayTrafficText" Text="0 B" FontSize="22" FontWeight="Bold" Margin="0,11,0,0"/><TextBlock Text="收发合计" Foreground="#64748B" FontSize="12"/></StackPanel></Border><Border Background="White" CornerRadius="10" Padding="18" Margin="0,12,0,0"><StackPanel><TextBlock Text="Security Events" Foreground="#64748B"/><TextBlock x:Name="SecurityEventCountText" Text="0" FontSize="28" FontWeight="Bold" Foreground="#D97706" Margin="0,8,0,0"/><TextBlock Text="最近记录" Foreground="#64748B" FontSize="12"/></StackPanel></Border></UniformGrid>
                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20" Margin="0,0,12,0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="服务器" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/><DataGrid x:Name="ServerGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="地址" Binding="{Binding Host}" Width="*"/><DataGridTextColumn Header="Interface" Binding="{Binding WireGuardInterface}" Width="*"/><DataGridTextColumn Header="WG 端口" Binding="{Binding WireGuardPort}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></Border><Border Grid.Column="1" Background="White" CornerRadius="10" Padding="20"><DockPanel><TextBlock DockPanel.Dock="Top" Text="最近安全事件（点击定位）" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/><DataGrid x:Name="SecurityGrid" AutoGenerateColumns="False" IsReadOnly="True" MouseLeftButtonUp="SecurityGrid_MouseLeftButtonUp" ToolTip="点击一条记录，打开安全事件明细并定位到该记录"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding OccurredAt}" Width="*"/><DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="*"/><DataGridTextColumn Header="详情" Binding="{Binding Description}" Width="2*"/></DataGrid.Columns></DataGrid></DockPanel></Border></Grid>
            </Grid>
            <Grid x:Name="ServersView" Visibility="Collapsed"><StackPanel><TextBlock Text="Servers" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="管理 WireGuard VPS 与 SSH 连接参数（SSH 私钥只在同步时选择，不写入数据库）" Foreground="#64748B" Margin="0,4,0,22"/><Border Background="White" CornerRadius="10" Padding="20"><StackPanel><TextBlock Text="添加或编辑服务器" FontSize="17" FontWeight="SemiBold"/><WrapPanel Margin="0,12,0,10"><TextBox x:Name="NewServerNameTextBox" Width="110" Margin="0,0,8,0" Padding="8" ToolTip="名称"/><TextBox x:Name="NewServerHostTextBox" Width="140" Margin="0,0,8,0" Padding="8" ToolTip="公网 IP/域名"/><TextBox x:Name="NewServerSshPortTextBox" Width="75" Text="22" Margin="0,0,8,0" Padding="8" ToolTip="SSH 端口"/><TextBox x:Name="NewServerSshUserTextBox" Width="95" Text="root" Margin="0,0,8,0" Padding="8" ToolTip="SSH 用户"/><TextBox x:Name="NewServerInterfaceTextBox" Width="80" Text="wg0" Margin="0,0,8,0" Padding="8" ToolTip="WireGuard Interface"/><TextBox x:Name="NewServerSubnetTextBox" Width="130" Margin="0,0,8,0" Padding="8" ToolTip="VPN 网段，例如 10.88.0.0/24"/><TextBox x:Name="NewServerWgPortTextBox" Width="85" Text="51894" Margin="0,0,8,0" Padding="8" ToolTip="目标 WireGuard UDP 端口"/><Button Content="添加" Click="AddServer_Click" Background="#2563EB" Foreground="White" Padding="15,6"/><Button Content="保存资料（不改端口）" Click="UpdateServer_Click" Margin="8,0,0,0" Padding="15,6" ToolTip="只保存名称、Host、SSH 参数、Interface 和 VPN 网段"/><Button Content="测试选中 SSH" Click="TestServer_Click" Margin="8,0,0,0" Padding="15,6"/><Button Content="切换 VPS 端口" Click="ChangeWireGuardPort_Click" Background="#D97706" Foreground="White" Margin="8,0,0,0" Padding="15,6" ToolTip="先放行新端口并验证，再删除旧端口规则"/></WrapPanel><TextBlock Text="WireGuard 端口只能通过橙色“切换 VPS 端口”修改。安全顺序：放行新 UDP 端口 → 备份并修改配置 → 重启并验证 → 删除旧 UFW 端口。成功后所有客户端 Endpoint 也必须改为新端口。" Foreground="#92400E" TextWrapping="Wrap" Margin="0,0,0,14"/><DataGrid x:Name="ServerManagementGrid" SelectionChanged="ServerSelectionChanged" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="*"/><DataGridTextColumn Header="SSH 用户" Binding="{Binding SshUser}" Width="*"/><DataGridTextColumn Header="Interface" Binding="{Binding WireGuardInterface}" Width="*"/><DataGridTextColumn Header="VPN 网段" Binding="{Binding VpnSubnet}" Width="*"/><DataGridTextColumn Header="WG 端口" Binding="{Binding WireGuardPort}" Width="*"/></DataGrid.Columns></DataGrid></StackPanel></Border></StackPanel></Grid>
            <Grid x:Name="PeersView" Visibility="Collapsed"><StackPanel><TextBlock Text="WireGuard Peers" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="服务器真实状态 · 只读同步" Foreground="#64748B" Margin="0,4,0,22"/><Border Background="White" CornerRadius="10" Padding="20"><DataGrid x:Name="PeerGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Server" Binding="{Binding ServerName}" Width="*"/><DataGridTextColumn Header="Interface" Binding="{Binding Interface}" Width="*"/><DataGridTextColumn Header="PublicKey" Binding="{Binding PublicKey}" Width="2*"/><DataGridTextColumn Header="Allowed IPs" Binding="{Binding AllowedIps}" Width="*"/><DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="*"/><DataGridTextColumn Header="Last Handshake" Binding="{Binding LatestHandshake}" Width="*"/><DataGridTextColumn Header="RX" Binding="{Binding TransferRx}" Width="*"/><DataGridTextColumn Header="TX" Binding="{Binding TransferTx}" Width="*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/></DataGrid.Columns></DataGrid></Border></StackPanel></Grid>
            <Grid x:Name="DevicesView" Visibility="Collapsed"><StackPanel><DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="Devices" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="设备身份以 WireGuard PublicKey 为核心" Foreground="#64748B" Margin="0,4,0,22"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="新增设备" Click="AddDevice_Click" Background="#2563EB" Foreground="White"/><Button Content="禁用选中" Click="DisableDevice_Click" Margin="8,3,0,3"/><Button Content="启用选中" Click="EnableDevice_Click" Margin="8,3,0,3"/><ComboBox x:Name="MigrationTargetComboBox" Width="120" DisplayMemberPath="Name" Margin="8,3,0,3"/><Button Content="迁移选中" Click="MigrateDevice_Click" Margin="8,3,0,3"/><Button Content="软删除选中" Click="DeleteDevice_Click" Margin="8,3,0,3"/></StackPanel></DockPanel><Border Background="White" CornerRadius="10" Padding="20"><DataGrid x:Name="DeviceGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="用户" Binding="{Binding UserName}" Width="*"/><DataGridTextColumn Header="PublicKey" Binding="{Binding PublicKey}" Width="2*"/><DataGridTextColumn Header="VPN IP" Binding="{Binding VpnIp}" Width="*"/><DataGridTextColumn Header="服务器" Binding="{Binding ServerName}" Width="*"/><DataGridTextColumn Header="Enabled" Binding="{Binding Enabled}" Width="*"/></DataGrid.Columns></DataGrid></Border></StackPanel></Grid>
            <Grid x:Name="DeviceEditView" Visibility="Collapsed"><StackPanel Width="560" HorizontalAlignment="Left"><TextBlock Text="新增设备" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="生成客户端密钥后，程序会通过 SSH 添加 Peer，并导出可导入手机或电脑的客户端配置。服务器私钥不会读取或保存。" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,25"/><TextBlock Text="设备名称"/><TextBox x:Name="DeviceNameTextBox" Margin="0,5,0,14" Padding="8"/><TextBlock Text="用户名称"/><TextBox x:Name="DeviceUserTextBox" Margin="0,5,0,14" Padding="8"/><TextBlock Text="所属服务器"/><ComboBox x:Name="DeviceServerComboBox" Margin="0,5,0,14" Padding="8" DisplayMemberPath="Name"/><TextBlock Text="SSH 用户（通常为 root）"/><TextBox x:Name="DeviceSshUserTextBox" Text="root" Margin="0,5,0,14" Padding="8"/><TextBlock Text="WireGuard 客户端密钥"/><StackPanel Orientation="Horizontal"><TextBox x:Name="DevicePublicKeyTextBox" IsReadOnly="True" Margin="0,5,8,14" Padding="8" Width="430"/><Button Content="生成官方密钥" Click="GenerateKeys_Click" Margin="0,5,0,14"/></StackPanel><TextBlock Text="VPN IP（可留空自动分配）"/><TextBox x:Name="DeviceVpnIpTextBox" Margin="0,5,0,20" Padding="8"/><StackPanel Orientation="Horizontal"><Button Content="添加 Peer 并导出配置" Click="SaveDevice_Click" Background="#2563EB" Foreground="White"/><Button Content="取消" Click="CancelDevice_Click" Margin="10,3,0,3"/></StackPanel></StackPanel></Grid>
            <Grid x:Name="OnlineDevicesView" Visibility="Collapsed"><StackPanel><TextBlock Text="Online Devices" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="OnlineThresholdDescriptionText" Text="最近 180 秒内完成握手的设备" Foreground="#64748B" Margin="0,4,0,22"/><Border Background="White" CornerRadius="10" Padding="20"><DataGrid x:Name="OnlineGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="设备" Binding="{Binding DeviceName}" Width="*"/><DataGridTextColumn Header="服务器" Binding="{Binding ServerName}" Width="*"/><DataGridTextColumn Header="VPN IP" Binding="{Binding VpnIp}" Width="*"/><DataGridTextColumn Header="公网 IP" Binding="{Binding PublicIp}" Width="*"/><DataGridTextColumn Header="最近握手" Binding="{Binding LatestHandshake}" Width="*"/></DataGrid.Columns></DataGrid></Border></StackPanel></Grid>
            <Grid x:Name="HistoryView" Visibility="Collapsed"><StackPanel><TextBlock Text="Connection History" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="根据 WireGuard 最近握手推断的连接记录" Foreground="#64748B" Margin="0,4,0,22"/><Border Background="White" CornerRadius="10" Padding="20"><DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="设备" Binding="{Binding DeviceName}" Width="*"/><DataGridTextColumn Header="服务器" Binding="{Binding ServerName}" Width="*"/><DataGridTextColumn Header="VPN IP" Binding="{Binding VpnIp}" Width="*"/><DataGridTextColumn Header="开始" Binding="{Binding ConnectedAt}" Width="*"/><DataGridTextColumn Header="结束" Binding="{Binding DisconnectedAt}" Width="*"/><DataGridTextColumn Header="RX" Binding="{Binding Rx}" Width="*"/><DataGridTextColumn Header="TX" Binding="{Binding Tx}" Width="*"/></DataGrid.Columns></DataGrid></Border></StackPanel></Grid>
            <Grid x:Name="TrafficView" Visibility="Collapsed"><StackPanel><TextBlock Text="Traffic" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="本地累计流量；检测到计数器重置时不会产生负数" Foreground="#64748B" Margin="0,4,0,22"/><Border Background="White" CornerRadius="10" Padding="20"><DataGrid x:Name="TrafficGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="设备/PublicKey" Binding="{Binding DeviceName}" Width="2*"/><DataGridTextColumn Header="服务器" Binding="{Binding ServerName}" Width="*"/><DataGridTextColumn Header="RX 累计" Binding="{Binding RxTotal}" Width="*"/><DataGridTextColumn Header="TX 累计" Binding="{Binding TxTotal}" Width="*"/><DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAt}" Width="*"/></DataGrid.Columns></DataGrid></Border></StackPanel></Grid>
            <Grid x:Name="UnknownPeersView" Visibility="Collapsed"><StackPanel><TextBlock Text="Unknown Peers" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="服务器存在但数据库没有匹配设备的 PublicKey；忽略后仍会显示，但不再重复生成安全事件" Foreground="#64748B" Margin="0,4,0,12" TextWrapping="Wrap"/><WrapPanel Margin="0,0,0,12"><TextBox x:Name="UnknownImportNameTextBox" Width="150" Padding="8" ToolTip="导入后的设备名称"/><TextBox x:Name="UnknownImportUserTextBox" Width="130" Padding="8" Margin="8,0,0,0" ToolTip="用户名称"/><Button Content="导入为设备" Click="ImportUnknownPeer_Click" Margin="8,0,0,0"/><Button Content="忽略/恢复提醒" Click="IgnoreUnknownPeer_Click" Margin="8,0,0,0"/><Button Content="二次确认后移除" Click="RemoveUnknownPeer_Click" Margin="8,0,0,0"/></WrapPanel><Border Background="White" CornerRadius="10" Padding="20"><DataGrid x:Name="UnknownGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="服务器" Binding="{Binding ServerName}" Width="*"/><DataGridTextColumn Header="PublicKey" Binding="{Binding PublicKey}" Width="2*"/><DataGridTextColumn Header="Allowed IPs" Binding="{Binding AllowedIps}" Width="*"/><DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="*"/><DataGridTextColumn Header="最近握手" Binding="{Binding LatestHandshake}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="*"/></DataGrid.Columns></DataGrid></Border></StackPanel></Grid>
            <Grid x:Name="SettingsView" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Width="700" HorizontalAlignment="Left">
                        <TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold"/>
                        <TextBlock Text="WireGuard 状态判定、Clash Verge 联动和已配置服务器" Foreground="#64748B" Margin="0,4,0,22"/>
                        <Border Background="White" CornerRadius="10" Padding="20">
                            <StackPanel>
                                <TextBlock Text="界面语言"/>
                                <ComboBox x:Name="LanguageComboBox" SelectedValuePath="Tag" Width="200" HorizontalAlignment="Left" Margin="0,6,0,16" Padding="8">
                                    <ComboBoxItem Content="简体中文" Tag="zh-CN"/>
                                    <ComboBoxItem Content="English" Tag="en-US"/>
                                </ComboBox>
                                <Separator Margin="0,0,0,16"/>
                                <TextBlock Text="Online 阈值（秒，仅允许 60/120/180/300/600）"/>
                                <TextBox x:Name="OnlineThresholdTextBox" Text="180" Width="160" HorizontalAlignment="Left" Margin="0,6,0,12" Padding="8"/>
                                <TextBlock Text="Offline Grace Period（秒，允许 0/60/120/300；用于短暂抖动）"/>
                                <TextBox x:Name="OfflineGraceTextBox" Text="60" Width="160" HorizontalAlignment="Left" Margin="0,6,0,12" Padding="8"/>
                                <Separator Margin="0,6,0,16"/>
                                <TextBlock Text="Clash Verge 配置联动" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="选择 Clash 配置文件夹。VPS 端口切换并验证成功后，程序会递归扫描其中所有 YAML，按服务器地址匹配 WireGuard 节点，逐文件备份并更新全部对应端口。" TextWrapping="Wrap" Foreground="#64748B" Margin="0,5,0,8"/>
                                <DockPanel LastChildFill="True">
                                    <Button Content="选择文件夹" Click="ChooseClashConfigDirectory_Click" Width="110" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                                    <TextBox x:Name="ClashConfigDirectoryTextBox" Padding="8" IsReadOnly="True" ToolTip="包含 Clash Verge YAML 配置的文件夹"/>
                                </DockPanel>
                                <CheckBox x:Name="AutoSyncClashCheckBox" Content="VPS 端口切换成功后自动匹配并同步文件夹内所有 Clash 配置" Margin="0,10,0,14"/>
                                <TextBlock Text="提示：如果 Clash Verge 正在运行，文件更新后可能需要在 Clash Verge 中重新载入该配置。订阅自动更新也可能覆盖本地修改。" TextWrapping="Wrap" Foreground="#B45309" Margin="0,0,0,16"/>
                                <Button Content="保存设置" Click="SaveSettings_Click" Width="120" HorizontalAlignment="Left" Background="#2563EB" Foreground="White"/>
                                <TextBlock x:Name="ConfiguredPortsText" Text="当前端口将在启动时载入。" TextWrapping="Wrap" Foreground="#64748B" Margin="0,18,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Grid x:Name="SecurityEventsView" Visibility="Collapsed"><StackPanel><TextBlock Text="Security Events" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="安全事件完整记录；从 Dashboard 单击事件后会自动定位到对应记录" Foreground="#64748B" Margin="0,4,0,22"/><Border Background="White" CornerRadius="10" Padding="20"><DataGrid x:Name="SecurityEventsGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding OccurredAt}" Width="220"/><DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="220"/><DataGridTextColumn Header="详情" Binding="{Binding Description}" Width="*"/></DataGrid.Columns></DataGrid></Border></StackPanel></Grid>
            <Grid x:Name="AuditLogsView" Visibility="Collapsed"><StackPanel><TextBlock Text="Audit Logs" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="管理员操作记录；不记录服务器私钥或客户端私钥" Foreground="#64748B" Margin="0,4,0,22"/><Border Background="White" CornerRadius="10" Padding="20"><DataGrid x:Name="AuditGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding OccurredAt}" Width="*"/><DataGridTextColumn Header="操作" Binding="{Binding Action}" Width="*"/><DataGridTextColumn Header="详情" Binding="{Binding Details}" Width="3*"/></DataGrid.Columns></DataGrid></Border></StackPanel></Grid>
            <Grid x:Name="UsersView" Visibility="Collapsed"><StackPanel><TextBlock Text="Users" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="设备归属用户；禁用用户不会删除设备历史" Foreground="#64748B" Margin="0,4,0,22"/><Border Background="White" CornerRadius="10" Padding="20"><StackPanel><StackPanel Orientation="Horizontal"><TextBox x:Name="NewUserTextBox" Width="300" Padding="8"/><Button Content="添加用户" Click="AddUser_Click" Margin="10,0,0,0" Background="#2563EB" Foreground="White"/><Button Content="启用/禁用" Click="ToggleUser_Click" Margin="8,0,0,0"/></StackPanel><DataGrid x:Name="UserGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,20,0,0"><DataGrid.Columns><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding Enabled}" Width="*"/><DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt}" Width="*"/></DataGrid.Columns></DataGrid></StackPanel></Border></StackPanel></Grid>
            <Grid x:Name="BlacklistView" Visibility="Collapsed"><StackPanel><TextBlock Text="Blacklist" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="记录需要阻止的公网 IP 或 CIDR；应用前需明确选择目标服务器" Foreground="#64748B" Margin="0,4,0,22"/><Border Background="White" CornerRadius="10" Padding="20"><StackPanel><StackPanel Orientation="Horizontal"><TextBox x:Name="NewBlacklistTextBox" Width="300" Padding="8"/><Button Content="添加黑名单" Click="AddBlacklist_Click" Margin="10,0,0,0" Background="#2563EB" Foreground="White"/><Button Content="启用/禁用" Click="ToggleBlacklist_Click" Margin="8,0,0,0"/><Button Content="删除" Click="DeleteBlacklist_Click" Margin="8,0,0,0"/></StackPanel><DataGrid x:Name="BlacklistGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,20,0,0"><DataGrid.Columns><DataGridTextColumn Header="地址/CIDR" Binding="{Binding Value}" Width="*"/><DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="启用" Binding="{Binding Enabled}" Width="*"/></DataGrid.Columns></DataGrid></StackPanel></Border></StackPanel></Grid>
            <Grid x:Name="WhitelistView" Visibility="Collapsed"><StackPanel><TextBlock Text="Whitelist" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="记录允许的公网 IP 或 CIDR；应用前需明确选择目标服务器" Foreground="#64748B" Margin="0,4,0,22"/><Border Background="White" CornerRadius="10" Padding="20"><StackPanel><StackPanel Orientation="Horizontal"><TextBox x:Name="NewWhitelistTextBox" Width="300" Padding="8"/><Button Content="添加白名单" Click="AddWhitelist_Click" Margin="10,0,0,0" Background="#2563EB" Foreground="White"/><Button Content="启用/禁用" Click="ToggleWhitelist_Click" Margin="8,0,0,0"/><Button Content="删除" Click="DeleteWhitelist_Click" Margin="8,0,0,0"/></StackPanel><DataGrid x:Name="WhitelistGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,20,0,0"><DataGrid.Columns><DataGridTextColumn Header="地址/CIDR" Binding="{Binding Value}" Width="*"/><DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="启用" Binding="{Binding Enabled}" Width="*"/></DataGrid.Columns></DataGrid></StackPanel></Border></StackPanel></Grid>
        </Grid>
    </Grid>
</Window>
